# =============================================================================
# Belagavi Tourism AI Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Google Gemini API ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model names — keep configurable, do not hard-code in source.
# Current supported models (verified September 2026):
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.5-flash

# Embedding output dimension (128-3072, recommended: 768, 1536, or 3072)
GEMINI_EMBEDDING_DIMENSION=768

# --- PostgreSQL + pgvector ---
# =============================================================================
# MODE A: Local Docker PostgreSQL (default)
# =============================================================================
# Individual connection parts — used when DATABASE_URL is NOT set.
# These drive the local Docker setup defined in docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=belagavi_tourism_ai
POSTGRES_USER=belagavi_user
POSTGRES_PASSWORD=change-this-strong-password

# =============================================================================
# MODE B: Supabase PostgreSQL (or any external PostgreSQL)
# =============================================================================
# Set DATABASE_URL to switch from local Docker to Supabase.
# When DATABASE_URL is set it WINS over the POSTGRES_* vars above.
# When DATABASE_URL is NOT set the POSTGRES_* vars above are used (Mode A).
#
# Get your connection string from:
#   Supabase dashboard → Project Settings → Database → Connection string → URI
#   Select "Session mode" pooler (port 5432) for SQLAlchemy compatibility.
#
# Supported URL formats (all are auto-normalised by config.py):
#   postgresql+asyncpg://...   (asyncpg — preferred)
#   postgresql://...           (plain — auto-prefixed to asyncpg for async engine)
#   postgres://...             (Heroku/Supabase alias — auto-normalised)
#
# Supabase session-mode pooler (recommended):
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Supabase direct connection (no pooler):
# DATABASE_URL=postgresql+asyncpg://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
#
# SYNC_DATABASE_URL is used by scripts/ingest.py and scripts/verify_supabase.py.
# If omitted it is automatically derived from DATABASE_URL.
# SYNC_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- FastAPI ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000","http://127.0.0.1:5500","https://belagavi-tourism-planner.web.app","https://belagavi-tourism-planner.firebaseapp.com"]

# --- RAG Settings ---
# Number of documents to retrieve per semantic search
RAG_TOP_K=5
# Minimum cosine similarity threshold (0.0 - 1.0)
RAG_SIMILARITY_THRESHOLD=0.3

# --- Logging ---
LOG_LEVEL=INFO
